<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- Página de la TV: la sirve TvServer desde la DLL, nunca el host de Blazor. -->
  <ItemGroup>
    <Content Remove="TvPage\**" />
    <None Remove="TvPage\**" />
    <EmbeddedResource Include="TvPage\**" LogicalName="tv/%(Filename)%(Extension)" />
    <EmbeddedResource Include="wwwroot\lib\konva\konva.min.js" LogicalName="tv/konva.min.js" />
    <EmbeddedResource Include="wwwroot\js\token-opacity.js" LogicalName="tv/token-opacity.js" />
    <EmbeddedResource Include="wwwroot\js\tv\*.js;wwwroot\css\tv-strip.css" LogicalName="tv/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\DmCompanion.UI\wwwroot\fonts\eb-garamond-latin-600-normal.woff2;..\DmCompanion.UI\wwwroot\fonts\source-sans-3-latin-400-normal.woff2;..\DmCompanion.UI\wwwroot\fonts\source-sans-3-latin-600-normal.woff2"
                      Link="TvPage\fonts\%(Filename)%(Extension)" LogicalName="tv/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmCompanion.Core\DmCompanion.Core.csproj" />
    <ProjectReference Include="..\DmCompanion.UI\DmCompanion.UI.csproj" />
  </ItemGroup>

</Project>
