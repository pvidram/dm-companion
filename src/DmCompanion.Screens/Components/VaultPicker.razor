@inherits DmComponentBase
@using DmCompanion.Core.Vault.Storage
@using DmCompanion.Screens.Platform
@inject IFolderBrowser Browser
@inject IStorageAccess Storage

<TableFrame>
    <Map>
        <div class="ds-frame__layer ds-frame__layer--placeholder"></div>
    </Map>
    <Overlays>
        <Parchment Title="Elige la carpeta del vault" Size="ParchmentSize.Wide">
            @if (Host.LastError is { } error)
            {
                <InlineNotice Kind="NoticeKind.Error">@error</InlineNotice>
            }
            @if (_listError is { } listError)
            {
                <InlineNotice Kind="NoticeKind.Error">@listError</InlineNotice>
            }

            <p>@_current</p>
            <Button Variant="ButtonVariant.Secondary" Disabled="@(!CanGoUp)" OnClick="GoUp">Subir</Button>
            <Button Variant="ButtonVariant.Primary" OnClick="UseCurrent">Usar esta carpeta</Button>

            @if (_folders.Count == 0)
            {
                <EmptyState Icon="IconName.Folder" Title="No hay subcarpetas">
                    Puedes usar esta carpeta como vault o subir un nivel.
                </EmptyState>
            }
            else
            {
                foreach (var name in _folders)
                {
                    var folder = name;
                    <ListRow Icon="IconName.Folder" OnSelect="() => Enter(folder)">@folder</ListRow>
                }
            }
        </Parchment>
    </Overlays>
</TableFrame>

@code {
    private string _root = string.Empty;
    private string _current = string.Empty;
    private string? _listError;
    private IReadOnlyList<string> _folders = [];

    private bool CanGoUp => Normalize(_current) != Normalize(_root);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _root = Storage.DefaultBrowseRoot;
        Navigate(_root);
    }

    private void Enter(string name) => Navigate(Path.Combine(_current, name));

    private void GoUp()
    {
        // Nunca por encima de la raíz de exploración.
        if (CanGoUp && Path.GetDirectoryName(Normalize(_current)) is { } parent) Navigate(parent);
    }

    private Task UseCurrent() => Host.OpenAsync(_current);

    private void Navigate(string path)
    {
        _current = path;
        try
        {
            _folders = Browser.ListSubdirectories(path);
            _listError = null;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _folders = [];
            _listError = $"No se puede leer «{path}»: {ex.Message}";
        }
    }

    private static string Normalize(string path) => path.Length > 1 ? path.TrimEnd('/', '\\') : path;
}
