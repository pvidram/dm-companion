@inherits DmComponentBase

<TableFrame>
    <Map>
        <div class="ds-frame__layer ds-frame__layer--placeholder"></div>
    </Map>
    <Overlays>
        <Parchment Title="Elige la carpeta del vault" Size="ParchmentSize.Wide">
            @if (Host.LastError is { } error)
            {
                <InlineNotice Kind="NoticeKind.Error">@error</InlineNotice>
            }
            <VaultBrowser OnUse="UseAsync" />
        </Parchment>
    </Overlays>
    <Dialogs>
        <ConfirmDialog Title="¿Abrir esta carpeta?" IsOpen="@(_unlikelyVault is not null)"
                       Message="@VaultBrowsing.UnlikelyVaultMessage"
                       ConfirmText="Abrir de todos modos" OnConfirm="ConfirmUnlikelyVault" OnCancel="CancelUnlikelyVault" />
    </Dialogs>
</TableFrame>

@code {
    private string? _unlikelyVault;

    private async Task UseAsync(VaultChoice choice)
    {
        if (!choice.LooksLikeVault)
        {
            _unlikelyVault = choice.Path;
            return;
        }
        await Host.OpenAsync(choice.Path);
    }

    private async Task ConfirmUnlikelyVault()
    {
        if (_unlikelyVault is not { } path) return;
        _unlikelyVault = null;
        await Host.OpenAsync(path);
    }

    private void CancelUnlikelyVault() => _unlikelyVault = null;
}
