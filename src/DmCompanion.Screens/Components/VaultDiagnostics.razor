@inherits DmComponentBase
@using System.Reflection
@using DmCompanion.Screens.Platform
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject GlossaryService Glossary

<TableFrame>
    <Map>
        <div class="ds-frame__layer ds-frame__layer--placeholder"></div>
    </Map>
    <Overlays>
        <Parchment Title="Diagnóstico del vault" Size="ParchmentSize.Wide">
            @if (Host.LastError is { } error)
            {
                <InlineNotice Kind="NoticeKind.Error">@error</InlineNotice>
            }

            @if (Services.GetService<ILogFolder>() is { IsAvailable: true } logs)
            {
                <Button Variant="ButtonVariant.Secondary" OnClick="() => OpenLogs(logs)">Abrir carpeta de registros</Button>
                @if (_logsNotice is { } logsNotice)
                {
                    <InlineNotice Kind="NoticeKind.Warning">@logsNotice</InlineNotice>
                }
            }

            @if (Host.Current is { } vault)
            {
                <dl>
                    <dt>Vault</dt>
                    <dd>@vault.RootPath</dd>
                    <dt>Notas</dt>
                    <dd>Notas: @Index.Count</dd>
                </dl>

                <h3>Campaña</h3>
                <dl>
                    <dt>Sistema activo</dt>
                    <dd>@vault.ActiveSystem.DisplayName</dd>
                    <dt>Nota de campaña</dt>
                    <dd>@(vault.Campaign.CampaignPath ?? "sin nota de campaña")</dd>
                </dl>
                @if (vault.Campaign.DiscardedPaths.Count > 0)
                {
                    <p>Campañas descartadas:</p>
                    <ul>
                        @foreach (var path in vault.Campaign.DiscardedPaths)
                        {
                            <li>@path</li>
                        }
                    </ul>
                }

                <h3>Avisos de fichas</h3>
                @if (SheetWarnings(vault).ToList() is { Count: > 0 } warnings)
                {
                    <ul>
                        @foreach (var (path, warning) in warnings)
                        {
                            <li>@path: @warning</li>
                        }
                    </ul>
                }
                else
                {
                    <p>Sin avisos.</p>
                }

                <h3>Conflictos de sincronización</h3>
                @if (vault.Conflicts.Count == 0)
                {
                    <p>Sin conflictos.</p>
                }
                else
                {
                    <ul>
                        @foreach (var conflict in vault.Conflicts)
                        {
                            <li>@conflict.OriginalRelativePath</li>
                        }
                    </ul>
                }

                <Button Variant="ButtonVariant.Secondary" OnClick="() => Host.OpenAsync(vault.RootPath)">Reabrir</Button>
            }
            else
            {
                <p>Sin vault abierto</p>
            }

            @if (Glossary.Warnings is { Count: > 0 } glossaryWarnings)
            {
                <h3>Glosario</h3>
                <ul>
                    @foreach (var warning in glossaryWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }

            <h3>Acerca de</h3>
            <p>DM Companion</p>
            <p>Versión: @Version</p>
            <p>@Glossary.AttributionText</p>
            <p>@GlossaryService.SrdUrl</p>
        </Parchment>
    </Overlays>
</TableFrame>

@code {
    private string? _logsNotice;

    private void OpenLogs(ILogFolder logs) =>
        _logsNotice = logs.Open() ? null : "No se pudo abrir la carpeta de registros. Ábrela a mano desde el Explorador.";

    // Sin el sufijo «+commit» que añade el SDK a la versión informativa.
    private static string Version =>
        Assembly.GetEntryAssembly()?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion is { Length: > 0 } raw
            ? raw.Split('+')[0]
            : "—";

    private static IEnumerable<(string Path, string Warning)> SheetWarnings(VaultService vault) =>
        vault.Index.Entities
            .Where(entity => entity.Type is EntityType.Pc or EntityType.Npc or EntityType.Monster)
            .OrderBy(entity => entity.RelativePath, StringComparer.Ordinal)
            .SelectMany(entity => vault.ActiveSystem.Evaluate(entity.Frontmatter).Warnings
                .Select(warning => (entity.RelativePath, warning)));
}
