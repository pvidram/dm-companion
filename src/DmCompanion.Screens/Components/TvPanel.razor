@inherits DmComponentBase
@inject PanelLayoutStore LayoutStore

<Parchment Title="TV" Resizable="@(true)" FrameSize="@Rail.FrameSize(LayoutKeys.Tv)" OnFrameChanged="@(c => Rail.OnChanged(LayoutKeys.Tv, c))" OnFrameReset="@(() => Rail.OnReset(LayoutKeys.Tv))" IsOpen="@(Shell.ActivePanel == OverlayPanel.Tv)" OnClose="@(() => Shell.Toggle(OverlayPanel.Tv))">
    <ChildContent>
        @* El contenido solo existe con el panel abierto: así el resto de pantallas no depende del servicio de la TV. *@
        @if (Shell.ActivePanel == OverlayPanel.Tv)
        {
            <TvPanelBody />
        }
    </ChildContent>
</Parchment>

@code {
    private RailPanelLayout? _rail;
    private RailPanelLayout Rail => _rail ??= new(LayoutStore, () => _ = InvokeAsync(StateHasChanged));
}
