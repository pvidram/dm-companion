@inherits DmComponentBase
@using DmCompanion.Core.GameSystems
@inject IServiceProvider Services

<article class="character-sheet">
    <PcPortrait Entity="Entity" />
    <h3 data-testid="pc-title">@Entity.Title</h3>
    <ShowOnTvButton Entity="Entity" />
    @if (JournalComponentBase.IsAvailable(Services))
    {
        <div class="glossary-tabs journal-tabs" role="tablist">
            <button type="button" role="tab" class="glossary-tab" aria-selected="@(Shell.PlayerTab == PlayerTab.Sheet ? "true" : "false")"
                    @onclick="() => Shell.SelectPlayerTab(PlayerTab.Sheet)">Ficha</button>
            <button type="button" role="tab" class="glossary-tab" aria-selected="@(Shell.PlayerTab == PlayerTab.Journal ? "true" : "false")"
                    @onclick="() => Shell.SelectPlayerTab(PlayerTab.Journal)">Diario</button>
        </div>
    }
    @if (Shell.PlayerTab == PlayerTab.Journal && JournalComponentBase.IsAvailable(Services))
    {
        <JournalTab Pc="Entity" />
    }
    else
    {
    @if (Entity.ParseError is { } error)
    {
        <InlineNotice Kind="NoticeKind.Warning">@error</InlineNotice>
    }
    @if (_system.IsKnown)
    {
        @if (_values.Warnings.Count > 0)
        {
            <details data-testid="sheet-warnings">
                <summary>Esta ficha tiene @_values.Warnings.Count @(_values.Warnings.Count == 1 ? "aviso" : "avisos")</summary>
                <InlineNotice Kind="NoticeKind.Warning">
                    <ul>
                        @foreach (var warning in _values.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </InlineNotice>
            </details>
        }
        @foreach (var group in _system.Definition.Groups)
        {
            @if (!UnheadedGroups.Contains(group.Id))
            {
                <h4>@group.Label</h4>
            }
            <div class="ds-stats" data-testid="@group.Id">
                @foreach (var stat in SheetStats.StatsOf(_system, _values, group))
                {
                    var value = _values.ById[stat.Id];
                    <div title="@(value.Source == StatSource.Missing ? value.Reason : null)">
                        <StatBadge Label="@SheetStats.LabelOf(group, stat)" Value="@value.Display" />
                    </div>
                }
            </div>
        }
    }
    else
    {
        @foreach (var warning in _values.Warnings)
        {
            <InlineNotice Kind="NoticeKind.Warning">@warning</InlineNotice>
        }
        <div class="ds-stats" data-testid="generic-stats">
            @foreach (var value in _values.ById.Values)
            {
                <StatBadge Label="@value.Id" Value="@value.Display" />
            }
        </div>
    }
    <NoteBody Entity="Entity" />
    }
</article>

@code {
    private static readonly HashSet<string> UnheadedGroups = ["basic", "abilities"];

    private IGameSystem _system = default!;
    private StatValues _values = StatValues.Empty;

    [Parameter, EditorRequired] public VaultEntity Entity { get; set; } = default!;

    protected override void OnParametersSet()
    {
        _system = Host.Current?.ActiveSystem ?? GameSystemRegistry.Default.Get("dnd5e");
        _values = _system.Evaluate(Entity.Frontmatter);
    }
}
