@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IServiceProvider Services
@inject ILogger<ShowOnTvButton> Log

@* «Mostrar en TV»: manda a la TV la ficha de PJ o la nota de lugar, filtrada para los jugadores. *@
@if (_tv is { Mode: not TvMode.Off } && TvContentFeed.CanShow(Entity))
{
    <Button Icon="IconName.Tv" Disabled="_busy" OnClick="ShowAsync">Mostrar en TV</Button>
}

@code {
    [Parameter, EditorRequired] public VaultEntity Entity { get; set; } = default!;

    private TvSession? _tv;
    private bool _busy;

    // La TV se resuelve opcionalmente: así las fichas y notas no obligan a registrar el servicio de la TV donde no se usa (tests).
    protected override void OnInitialized()
    {
        _tv = Services.GetService<TvSession>();
        if (_tv is not null) _tv.Changed += OnChanged;
    }

    private async Task ShowAsync()
    {
        if (_tv is null) return;
        _busy = true;
        try
        {
            await _tv.ShowContentAsync(Entity.RelativePath);
        }
        catch (Exception ex)
        {
            Log.LogError("No se pudo mostrar la nota en la TV ({ExceptionType}).", ex.GetType().FullName);
        }
        finally
        {
            _busy = false;
        }
    }

    // Llega desde otros hilos (servidor de la TV, cambios del vault): hay que volver al dispatcher.
    private void OnChanged(object? sender, EventArgs e) => _ = RefreshAsync();

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // El botón ya se retiró mientras llegaba el evento.
        }
        catch (Exception ex)
        {
            Log.LogError("Fallo al refrescar el botón «Mostrar en TV» ({ExceptionType}).", ex.GetType().FullName);
        }
    }

    public void Dispose()
    {
        if (_tv is not null) _tv.Changed -= OnChanged;
    }
}
