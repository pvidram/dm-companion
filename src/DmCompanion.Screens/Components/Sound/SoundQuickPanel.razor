@inherits SoundControlBase
@using DmCompanion.UI.Interop
@inject PanelLayoutStore Layout

@* Panel rápido de sonido: popover bajo la franja (la franja recorta lo que sobresale, por eso vive en Overlays). Tocar fuera lo cierra, salvo anclado: entonces es una ventana flotante que se mueve y redimensiona. *@
@if (Shell.SoundQuickOpen)
{
    @if (!Pinned)
    {
        <div class="sound-quick__backdrop" data-testid="sound-quick-backdrop" @onclick="Shell.CloseSoundQuick"></div>
    }
    <QuickCard class="sound-quick" data-testid="sound-quick" Title="Sonido"
               Draggable="true" Resizable="true" FrameSize="Layout.GetSize(LayoutKeys.SoundQuick)" Anchor="@(Pinned ? Layout.GetAnchor(LayoutKeys.SoundQuick) : null)"
               IsPinned="Pinned" OnPinnedChanged="SetPinned" OnFrameChanged="OnFrameChanged" OnFrameReset="@(() => Layout.ResetSize(LayoutKeys.SoundQuick))"
               OnClose="Close">
        @if (Notice is { } notice)
        {
            <InlineNotice Kind="NoticeKind.Warning">@notice</InlineNotice>
        }
        <h4 class="sound-quick__heading">Favoritos</h4>
        @if (Store.Favorites.Count == 0)
        {
            <p class="sound-quick__empty">Sin favoritos.</p>
        }
        @foreach (var path in Store.Favorites)
        {
            var track = Tracks.FindTrack(path);
            var favorite = path;
            <button type="button" class="sound-quick__item" data-testid="sound-favorite" disabled="@(track is null)" @onclick="() => PlayFavoriteAsync(favorite)">
                <Icon Name="IconName.Play" />
                <span>@(track?.Name ?? path)</span>
                @if (track is null)
                {
                    <span class="sound-quick__note">no encontrado</span>
                }
            </button>
        }
        <h4 class="sound-quick__heading">Escenas</h4>
        @if (Store.SceneNames.Count == 0)
        {
            <p class="sound-quick__empty">Sin escenas.</p>
        }
        @foreach (var name in Store.SceneNames)
        {
            var scene = name;
            <button type="button" class="sound-quick__item" data-testid="sound-scene" @onclick="() => LaunchSceneAsync(scene)">
                <Icon Name="IconName.Music" />
                <span>@scene</span>
            </button>
        }
    </QuickCard>
}

@code {
    // Última posición soltada en esta apertura: al anclar se guarda como ancla (el JS solo informa al soltar).
    private WindowAnchor? _lastAnchor;

    private bool Pinned => Layout.IsPinned(LayoutKeys.SoundQuick);

    private void SetPinned(bool pinned)
    {
        Layout.SetPinned(LayoutKeys.SoundQuick, pinned);
        Layout.SetAnchor(LayoutKeys.SoundQuick, pinned ? _lastAnchor : null);
    }

    // El tamaño se recuerda anclado o no; la posición solo si está anclado (sin anclar, la de la hoja de estilos).
    private void OnFrameChanged(WindowFrameChange change)
    {
        if (change.Size is { } size) Layout.SetSize(LayoutKeys.SoundQuick, size);
        _lastAnchor = change.Anchor;
        if (Pinned) Layout.SetAnchor(LayoutKeys.SoundQuick, change.Anchor);
    }

    // Cerrado por cualquier vía, la próxima apertura vuelve a empezar sin posición recordada.
    protected override void OnAfterRender(bool firstRender)
    {
        if (!(Shell.SoundQuickOpen)) _lastAnchor = null;
    }

    // La X (y Esc) cierra y quita la chincheta.
    private void Close()
    {
        SetPinned(false);
        Shell.CloseSoundQuick();
    }

    // Los favoritos suenan como efecto de una vez: repetir o hacer bucle se decide en la pantalla Sonido.
    private async Task PlayFavoriteAsync(string path)
    {
        if (await Mixer.PlayEffectAsync(path) is null) ShowNotice(SoundNotices.NotFound(Tracks.FindTrack(path)?.Name ?? path));
    }

    private async Task LaunchSceneAsync(string name)
    {
        if (await Store.LoadSceneAsync(name) is not { } scene)
        {
            ShowNotice(SoundNotices.NotFound(name));
            return;
        }
        if (await Mixer.LaunchSceneAsync(scene) is { Count: > 0 } missing) ShowNotice(SoundNotices.Missing(missing));
    }
}
