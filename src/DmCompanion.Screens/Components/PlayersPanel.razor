@inherits DmComponentBase
@inject PanelLayoutStore LayoutStore
@inject IServiceProvider Services

<Parchment Title="Jugadores" Resizable="@(true)" FrameSize="@Rail.FrameSize(LayoutKeys.Players)" OnFrameChanged="@(c => Rail.OnChanged(LayoutKeys.Players, c))" OnFrameReset="@(() => Rail.OnReset(LayoutKeys.Players))" Size="ParchmentSize.Wide" IsOpen="@(Shell.ActivePanel == OverlayPanel.Players)"
           OnClose="@(() => Shell.Toggle(OverlayPanel.Players))">
    <ChildContent>
        @if (JournalLogSection.CanShow(Services))
        {
            <JournalLogSection />
        }
        @{
            var pcs = Index.OfType(EntityType.Pc);
        }
        @if (pcs.Count == 0)
        {
            <EmptyState Icon="IconName.Users" Title="Sin jugadores">Pulsa «Añadir jugador» o crea una nota con <code>type: pc</code>.</EmptyState>
        }
        else
        {
            <div>
                @foreach (var pc in pcs)
                {
                    var path = pc.RelativePath;
                    <ListRow IsSelected="@(path == Shell.SelectedPcPath)" OnSelect="() => Shell.SelectPc(path)">
                        <PcPortrait Entity="pc" />
                        @pc.Title
                    </ListRow>
                }
            </div>
            @if (Shell.SelectedPcPath is { } selected && Index.Get(selected) is { } entity)
            {
                <CharacterSheet Entity="entity" />
            }
            else
            {
                <EmptyState Icon="IconName.Users" Title="Ficha">Elige un personaje de la lista.</EmptyState>
            }
        }
    </ChildContent>
    <Actions>
        <Button Icon="IconName.UserPlus" data-testid="add-player" OnClick="Shell.OpenAddPlayer">Añadir jugador</Button>
        @if (Shell.SelectedPcPath is { } path && Index.Get(path) is not null)
        {
            <Button Icon="IconName.ScrollText" OnClick="@(() => Shell.RequestOpenNote(path))">Abrir nota</Button>
            <Button Icon="IconName.FileText" OnClick="@(() => Shell.RequestEditNote(path))">Editar</Button>
        }
    </Actions>
</Parchment>

@code {
    private RailPanelLayout? _rail;
    private RailPanelLayout Rail => _rail ??= new(LayoutStore, () => _ = InvokeAsync(StateHasChanged));
}
