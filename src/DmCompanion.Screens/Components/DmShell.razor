@inherits DmComponentBase
@inject MapSession Maps

<TableFrame>
    <Rail>
        <RailButton Icon="IconName.Users" Label="Jugadores" IsPressed="@(Shell.ActivePanel == OverlayPanel.Players)"
                    OnToggle="@(() => Shell.Toggle(OverlayPanel.Players))" />
        <RailButton Icon="IconName.ScrollText" Label="Notas" IsPressed="@(Shell.ActivePanel == OverlayPanel.Notes)"
                    OnToggle="@(() => Shell.Toggle(OverlayPanel.Notes))" />
        <RailButton Icon="IconName.Map" Label="Mapas" IsPressed="@(Shell.ActivePanel == OverlayPanel.Maps)"
                    OnToggle="@(() => Shell.Toggle(OverlayPanel.Maps))" />
        <RailButton Icon="IconName.FolderOpen" Label="Cambiar vault" OnToggle="ForgetAsync" />
    </Rail>
    <Strip>
        @if (Host.Current is { Conflicts.Count: > 0 } vault)
        {
            <InlineNotice Kind="NoticeKind.Warning">
                @ConflictText(vault.Conflicts.Count)
                <Button OnClick="Shell.OpenConflicts">Revisar</Button>
            </InlineNotice>
        }
        <CombatStripBar />
    </Strip>
    <Map>
        <div class="map-layout">
            <div class="map-layout__canvas">
                <MapCanvas OnAddToken="Shell.OpenAddToken"><Notices><CombatMapNotices /></Notices></MapCanvas>
            </div>
            <CombatStrip />
        </div>
    </Map>
    <Overlays>
        <NotesPanel />
        <PlayersPanel />
        <CombatHistoryPopover />
        <TokenCard />
        <MapsPanel />
    </Overlays>
    <Dialogs>
        <NewNoteDialog />
        <MapNameDialog />
        <MapConfirmDialogs />
        <ConflictResolver />
        <AddTokenDialog />
        <StartCombatDialog />
        <EditorDialogs />
        <CombatEndDialog />
    </Dialogs>
</TableFrame>

@code {
    // Al entrar en el shell se recupera el último mapa del vault (si hay uno recordado y aún no hay otro abierto).
    protected override async Task OnInitializedAsync()
    {
        if (Maps.Current is null) await Maps.OpenLastAsync();
    }

    private static string ConflictText(int count) =>
        count == 1 ? "1 conflicto de sincronización" : $"{count} conflictos de sincronización";

    private async Task ForgetAsync()
    {
        await Shell.RequestNavigationAsync(async () =>
        {
            Shell.Reset();
            await Host.ForgetAsync();
        });
    }
}
