@inherits DmComponentBase
@inject MapSession Maps
@inject IServiceProvider Services
@using DmCompanion.Screens.Components.Sound

<TableFrame>
    <Rail>
        <RailButton Icon="IconName.Users" Label="Jugadores" IsPressed="@(Shell.ActivePanel == OverlayPanel.Players)"
                    OnToggle="@(() => Shell.Toggle(OverlayPanel.Players))" />
        <RailButton Icon="IconName.ScrollText" Label="Notas" IsPressed="@(Shell.ActivePanel == OverlayPanel.Notes)"
                    OnToggle="@(() => Shell.Toggle(OverlayPanel.Notes))" />
        <RailButton Icon="IconName.BookOpen" Label="Glosario" IsPressed="@(Shell.ActivePanel == OverlayPanel.Glossary)"
                    OnToggle="@(() => Shell.Toggle(OverlayPanel.Glossary))" />
        <RailButton Icon="IconName.Map" Label="Mapas" IsPressed="@(Shell.ActivePanel == OverlayPanel.Maps)"
                    OnToggle="@(() => Shell.Toggle(OverlayPanel.Maps))" />
        <RailButton Icon="IconName.Music" Label="Sonido" IsPressed="@(Shell.ActivePanel == OverlayPanel.Sound)"
                    OnToggle="@(() => Shell.Toggle(OverlayPanel.Sound))" />
        <RailButton Icon="IconName.Tv" Label="TV" IsPressed="@(Shell.ActivePanel == OverlayPanel.Tv)"
                    OnToggle="@(() => Shell.Toggle(OverlayPanel.Tv))" />
        <div class="dm-shell__rail-bottom">
            <RailButton Icon="IconName.FolderOpen" Label="Cambiar vault" IsPressed="@(Shell.ActivePanel == OverlayPanel.Vault)"
                        OnToggle="@(() => Shell.Toggle(OverlayPanel.Vault))" />
        </div>
    </Rail>
    <Strip>
        @if (Host.Current is { Conflicts.Count: > 0 } vault)
        {
            <InlineNotice Kind="NoticeKind.Warning">
                @ConflictText(vault.Conflicts.Count)
                <Button OnClick="Shell.OpenConflicts">Revisar</Button>
            </InlineNotice>
        }
        <TvNowShowing />
        <CombatStripBar />
        <SoundMiniControl />
    </Strip>
    <Map>
        <div class="map-layout">
            <div class="map-layout__canvas">
                <MapCanvas OnAddToken="Shell.OpenAddToken"><Notices><CombatMapNotices /></Notices></MapCanvas>
            </div>
            <CombatStrip />
        </div>
    </Map>
    <Overlays>
        <NotesPanel />
        <PlayersPanel />
        <GlossaryPanel />
        <CombatHistoryPopover />
        <SoundQuickPanel />
        <TokenCardLayer />
        <MapsPanel />
        <SoundPanel />
        <VaultPanel />
        <TvPanel />
    </Overlays>
    <Dialogs>
        <NewNoteDialog />
        <AddPlayerDialog />
        <MapNameDialog />
        <MapConfirmDialogs />
        <ConflictResolver />
        <AddTokenDialog />
        <StartCombatDialog />
        <EditorDialogs />
        <CombatEndDialog />
        <SoundDialogs />
        <VaultSwitchDialog />
        <NewFolderDialog />
        <CreateVaultDialog />
        @if (JournalFormDialog.CanEdit(Services))
        {
            <JournalFormDialog />
            <JournalDeleteDialog />
        }
    </Dialogs>
</TableFrame>

@code {
    // Al entrar en el shell se recupera el último mapa del vault (si hay uno recordado y aún no hay otro abierto).
    protected override async Task OnInitializedAsync()
    {
        if (Maps.Current is null) await Maps.OpenLastAsync();
    }

    private static string ConflictText(int count) =>
        count == 1 ? "1 conflicto de sincronización" : $"{count} conflictos de sincronización";
}
