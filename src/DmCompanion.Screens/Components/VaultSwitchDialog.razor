@inherits DmComponentBase

<UnlikelyVaultDialog IsOpen="@(Shell.ConfirmingVaultPath is not null)" CanCreate="Shell.ConfirmingVaultCanCreate"
                     OnOpenAnyway="ConfirmAsync" OnCreate="CreateHere" OnCancel="Shell.CloseVaultConfirm" />

@code {
    private async Task ConfirmAsync()
    {
        if (Shell.ConfirmingVaultPath is not { } path) return;
        Shell.CloseVaultConfirm();
        await VaultBrowsing.SwitchAsync(Host, Shell, path);
    }

    private void CreateHere()
    {
        if (Shell.ConfirmingVaultPath is not { } path) return;
        Shell.CloseVaultConfirm();
        Shell.RequestCreateVault(path, CreateAndOpenAsync);
    }

    // La confirmación de cambios sin guardar va primero: si se cancela, no se crea nada.
    private Task CreateAndOpenAsync(string path) => VaultBrowsing.SwitchAsync(Host, Shell, path);
}
