@inherits DmComponentBase
@inject PortraitUrlProvider Portraits

<TokenAvatar Name="@Entity.Title" Faction="Faction.Pc" PortraitUrl="@_result.Url" />

@code {
    [Parameter, EditorRequired] public VaultEntity Entity { get; set; } = default!;

    private PortraitResult _result = new(null, PortraitStatus.None);

    protected override async Task OnParametersSetAsync() => _result = await Portraits.GetAsync(Entity.Portrait);
}
