@inherits DmComponentBase
@using DmCompanion.Core.Maps
@using DmCompanion.Screens.Platform
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@inject MapSession Session
@inject MapCanvasInterop Canvas
@inject ILogger<MapControls> Log
@inject CombatController Combat
@inject IAppPreferences Prefs
@inject IServiceProvider Services

@* Durante el ajuste con los dedos la barra entera se oculta (sin tocar la preferencia de plegado): nada de ella puede mutar el mapa y cancelarlo. *@
@if (Session.Editor is { } editor && !Canvas.GridAdjusting)
{
    var grid = editor.State.Grid;
    var readOnly = Session.IsReadOnly;
    var mode = EffectiveMode;
    var tool = Canvas.Tool;
    var viewing = Preview is { IsActive: true };
    <MapToolbar Label="Herramientas del mapa" Edge="MapToolbarEdge.Bottom" class="@("map-controls" + (_toolbarVisible ? string.Empty : " map-controls--folded"))">
        @if (_toolbarVisible)
        {
        <MapToolbarGroup Label="Modo">
            <IconButton Icon="IconName.Hand" Label="Navegar" Disabled="viewing" IsPressed="@(mode == MapMode.Navigate)" OnClick="() => SetModeAsync(MapMode.Navigate)" />
            @if (!readOnly)
            {
                <IconButton Icon="IconName.Pencil" Label="Dibujar" Disabled="viewing" IsPressed="@(mode == MapMode.Draw)" OnClick="() => SetModeAsync(MapMode.Draw)" />
            }
            @if (!readOnly)
            {
                <IconButton Icon="IconName.CloudFog" Label="Niebla" Disabled="viewing" IsPressed="@(mode == MapMode.Fog)" OnClick="() => SetModeAsync(MapMode.Fog)" />
            }
            <IconButton Icon="IconName.Ruler" Label="Medir" Disabled="viewing" IsPressed="@(mode == MapMode.Measure)" OnClick="() => SetModeAsync(MapMode.Measure)" />
        </MapToolbarGroup>

        @if (mode == MapMode.Draw)
        {
            <MapToolbarGroup Label="Color">
                @for (var i = 0; i < Palette.Count; i++)
                {
                    var color = Palette[i];
                    <button type="button" class="map-controls__swatch" style="background-color: @color"
                            aria-label="Color @(i + 1)" title="@ColorNames[i]" disabled="@viewing" aria-pressed="@Pressed(!tool.Eraser && tool.Color == color)"
                            @onclick="() => ChooseAsync(tool with { Color = color, Eraser = false })"></button>
                }
            </MapToolbarGroup>
            <MapToolbarGroup Label="Grosor">
                @foreach (var width in Widths)
                {
                    var dot = Format(width + 4);
                    <button type="button" class="map-controls__width" aria-label="Grosor @Format(width)" disabled="@viewing"
                            aria-pressed="@Pressed(!tool.Eraser && tool.Width == width)"
                            @onclick="() => ChooseAsync(tool with { Width = width, Eraser = false })">
                        <span class="map-controls__dot" style="width: @(dot)px; height: @(dot)px"></span>
                    </button>
                }
            </MapToolbarGroup>
            <MapToolbarGroup Label="Trazos">
                <IconButton Icon="IconName.Eraser" Label="Goma" Disabled="viewing" IsPressed="@tool.Eraser" OnClick="() => ChooseAsync(tool with { Eraser = !tool.Eraser })" />
                <IconButton Icon="IconName.Undo2" Label="Deshacer" Disabled="@(viewing || !editor.CanUndo)" OnClick="() => Session.Mutate(e => e.Undo())" />
                <IconButton Icon="IconName.Redo2" Label="Rehacer" Disabled="@(viewing || !editor.CanRedo)" OnClick="() => Session.Mutate(e => e.Redo())" />
            </MapToolbarGroup>
        }

        @if (mode == MapMode.Fog)
        {
            <FogControls Disabled="viewing" />
        }

        <MapToolbarGroup Label="Cuadrícula">
            <Checkbox Label="Cuadrícula" Value="grid.Enabled" Disabled="@(readOnly || viewing)"
                      ValueChanged="on => ChangeGrid(g => g with { Enabled = on })" />
            <IconButton Icon="IconName.Settings" Label="Ajustes de cuadrícula" Disabled="@(readOnly || viewing)" IsPressed="@(_gridOpen && !readOnly && !viewing)"
                        OnClick="() => _gridOpen = !_gridOpen" aria-expanded="@Pressed(_gridOpen && !readOnly && !viewing)" />
        </MapToolbarGroup>

        <MapToolbarGroup Label="Mapa">
            @if (!readOnly)
            {
                <IconButton Icon="IconName.UserPlus" Label="Añadir token" Disabled="viewing" OnClick="OnAddToken" />
            }
            <IconButton Icon="IconName.Maximize" Label="Ajustar a pantalla" Disabled="viewing" OnClick="() => Canvas.FitAsync()" />
            <TvFrameButton Compact Disabled="viewing" />
            @if (Preview is not null)
            {
                <IconButton Icon="IconName.Eye" Label="Vista de jugadores" IsPressed="viewing" OnClick="Preview.Toggle" />
            }
        </MapToolbarGroup>

        @if (!readOnly && !Combat.IsActive)
        {
            <MapToolbarGroup Label="Combate">
                <IconButton Icon="IconName.Swords" Label="Empezar combate" Disabled="viewing" OnClick="Shell.OpenStartCombat" />
            </MapToolbarGroup>
        }
        }

        @* Siempre visible, al extremo derecho de la barra; plegada, la barra queda reducida a este botón en la esquina. *@
        <MapToolbarGroup Label="Barra" class="map-controls__toggle-group">
            <IconButton Icon="IconName.ChevronRight" Label="@(_toolbarVisible ? "Ocultar la barra de herramientas" : "Mostrar la barra de herramientas")"
                        class="@("map-controls__toggle" + (_toolbarVisible ? " map-controls__toggle--open" : string.Empty))"
                        aria-expanded="@Pressed(_toolbarVisible)" OnClick="ToggleToolbar" />
        </MapToolbarGroup>
    </MapToolbar>

    @if (_toolbarVisible && _gridOpen && !readOnly && !viewing)
    {
        <div class="map-controls__panel" role="group" aria-label="Ajustes de la cuadrícula">
            <NumberStepper Label="Tamaño de casilla" Unit="px" Min="MinCell" Max="MaxCell" Value="grid.CellSize"
                           ValueChanged="size => ChangeGrid(g => Resized(g, size))" />
            <NumberStepper Label="Desplazamiento X" Unit="px" Min="0" Max="grid.CellSize" Value="grid.OffsetX"
                           ValueChanged="x => ChangeGrid(g => g with { OffsetX = x })" />
            <NumberStepper Label="Desplazamiento Y" Unit="px" Min="0" Max="grid.CellSize" Value="grid.OffsetY"
                           ValueChanged="y => ChangeGrid(g => g with { OffsetY = y })" />
            <Button Disabled="@(Combat.IsActive || !grid.Enabled)" OnClick="BeginAdjustAsync">Ajustar con los dedos</Button>
            <Button Disabled="@(Combat.IsActive)" OnClick="BeginCalibrateAsync">Calibrar con un rectángulo</Button>
        </div>
    }
}

@code {
    /// <summary>Colores de la tinta: valores de los tokens del design system (tinta, rojo, azul, verde, latón y hueso).</summary>
    public static readonly IReadOnlyList<string> Palette = [DrawTool.DefaultColor, "#9E2B25", "#3E6A8E", "#4F7A4A", "#C9A24A", "#E8DCC2"];
    private static readonly string[] ColorNames = ["Tinta", "Rojo", "Azul", "Verde", "Latón", "Hueso"];
    public static readonly IReadOnlyList<double> Widths = [3, 6, 12];

    private const double MinCell = MapCanvasInterop.MinCellSize;
    private const double MaxCell = MapCanvasInterop.MaxCellSize;

    /// <summary>«Añadir token» de la barra; lo conecta el diálogo de la Task 10.</summary>
    [Parameter] public EventCallback OnAddToken { get; set; }

    private const string ToolbarVisibleKey = "map.toolbar.visible";

    private bool _gridOpen;
    // Opcional, como TvFrameButton: sin el servicio no hay botón (no hace falta registrarlo donde no se usa).
    private PlayerPreview? Preview;
    private bool _toolbarVisible = true;

    // En solo lectura no se dibuja ni se toca la niebla: aunque se recordara Dibujar, se muestra y se comporta como Navegar.
    private MapMode EffectiveMode => Session.IsReadOnly && Canvas.Mode is MapMode.Draw or MapMode.Fog ? MapMode.Navigate : Canvas.Mode;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _toolbarVisible = Prefs.Get(ToolbarVisibleKey) != "false";
        Session.Changed += OnSessionChanged;
        Canvas.GridAdjustChanged += OnSessionChanged;
        Preview = Services.GetService<PlayerPreview>();
        if (Preview is not null) Preview.Changed += OnSessionChanged;
    }

    public override void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Canvas.GridAdjustChanged -= OnSessionChanged;
        if (Preview is not null) Preview.Changed -= OnSessionChanged;
        base.Dispose();
    }

    // Llega desde hilos del watcher o del temporizador de guardado: hay que volver al dispatcher.
    private void OnSessionChanged(object? sender, EventArgs e) => _ = RefreshAsync();

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // La barra ya se retiró mientras llegaba el evento.
        }
        catch (Exception ex)
        {
            Log.LogError("Fallo al refrescar la barra del mapa ({ExceptionType}).", ex.GetType().FullName);
        }
    }

    // Plegar no toca el modo activo; solo cierra los desplegables de la barra.
    private void ToggleToolbar()
    {
        _toolbarVisible = !_toolbarVisible;
        if (!_toolbarVisible) _gridOpen = false;
        Prefs.Set(ToolbarVisibleKey, _toolbarVisible ? "true" : "false");
    }

    // El ajuste ocupa el mapa: el panel se cierra y sus valores, al reabrirlo, son los vigentes.
    private async Task BeginAdjustAsync()
    {
        _gridOpen = false;
        await Canvas.BeginGridAdjustAsync();
    }

    private async Task BeginCalibrateAsync()
    {
        _gridOpen = false;
        await Canvas.BeginGridCalibrateAsync();
    }

    private Task SetModeAsync(MapMode mode) => Canvas.SetModeAsync(mode, Canvas.Tool);

    private Task ChooseAsync(DrawTool tool) => Canvas.SetModeAsync(MapMode.Draw, tool);

    private void ChangeGrid(Func<GridSettings, GridSettings> change) =>
        Session.Mutate(editor =>
        {
            var current = editor.State.Grid;
            var next = change(current);
            if (next == current || !MapStateSerializer.IsValidGrid(next)) return false;
            editor.SetGrid(next);
            return true;
        });

    // Con una casilla más pequeña el desplazamiento no puede pasarse de ella.
    private static GridSettings Resized(GridSettings grid, double size) =>
        grid with { CellSize = size, OffsetX = Math.Min(grid.OffsetX, size), OffsetY = Math.Min(grid.OffsetY, size) };

    private static string Format(double value) => value.ToString(CultureInfo.InvariantCulture);
    private static string Pressed(bool value) => value ? "true" : "false";
}
