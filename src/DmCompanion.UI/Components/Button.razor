<button @attributes="AdditionalAttributes" type="button" class="@CssClass" disabled="@Disabled" @onclick="OnClick">
    @if (Icon is { } icon)
    {
        <Icon Name="icon" />
    }
    @ChildContent
</button>

@code {
    /// <summary>Variante visual. Primary: acción principal; Secondary: por defecto; Damage y Heal: combate (táctil 56 px).</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;
    /// <summary>Tamaño táctil de combate (56 px).</summary>
    [Parameter] public bool Combat { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Icono opcional antes del texto.</summary>
    [Parameter] public IconName? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Se invoca al pulsar.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Atributos HTML adicionales para el elemento raíz. Los que fija el componente (aria-*, disabled…) prevalecen; <c>class</c> se añade a las clases propias.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => AttributeMerge.Class(
        $"ds-button ds-button--{Variant.ToString().ToLowerInvariant()}" + (Combat ? " ds-button--combat" : string.Empty),
        AdditionalAttributes);
}
