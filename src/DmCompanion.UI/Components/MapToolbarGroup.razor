<div @attributes="AdditionalAttributes" class="@CssClass" role="group" aria-label="@Label">
    @ChildContent
</div>

@code {
    /// <summary>Nombre accesible opcional del grupo (p. ej. «Zoom»).</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Atributos HTML adicionales para el elemento raíz. Los que fija el componente (role, aria-*) prevalecen; <c>class</c> se añade a las clases propias.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => AttributeMerge.Class("ds-map-toolbar__group", AdditionalAttributes);
}
