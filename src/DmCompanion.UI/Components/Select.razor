@typeparam TValue
@using System.Globalization

<label class="ds-field ds-field--select">
    <span class="ds-field__label">@Label</span>
    <select @attributes="AdditionalAttributes" class="@CssClass" disabled="@Disabled" @onchange="OnChangeAsync">
        @if (!HasSelection)
        {
            <option value="" disabled selected hidden></option>
        }
        @for (var i = 0; i < Options.Count; i++)
        {
            var option = Options[i];
            <option value="@i.ToString(CultureInfo.InvariantCulture)" selected="@IsSelected(option)">@LabelOf(option)</option>
        }
    </select>
    <Icon Name="IconName.ChevronRight" Class="ds-field__chevron" />
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<TValue> Options { get; set; } = [];
    [Parameter, EditorRequired] public Func<TValue, string> LabelOf { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Atributos HTML adicionales para el <c>select</c>. Los que fija el componente (disabled…) prevalecen; <c>class</c> se añade a las clases propias.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsSelected(TValue option) => EqualityComparer<TValue>.Default.Equals(option, Value);
    private bool HasSelection => Options.Any(IsSelected);
    private string CssClass => AttributeMerge.Class("ds-field__input ds-field__select", AdditionalAttributes);

    private Task OnChangeAsync(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var index) && index < Options.Count
            ? ValueChanged.InvokeAsync(Options[index])
            : Task.CompletedTask;
}
