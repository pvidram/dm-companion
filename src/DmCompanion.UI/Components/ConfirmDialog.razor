<Dialog Title="@Title" IsOpen="IsOpen" OnClose="OnCancel">
    <ChildContent><p>@Message</p></ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="OnCancel">@CancelText</Button>
        <Button Variant="@(Destructive ? ButtonVariant.Damage : ButtonVariant.Primary)" OnClick="OnConfirm">@ConfirmText</Button>
    </Footer>
</Dialog>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
    /// <summary>Cerrado por defecto.</summary>
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Aceptar";
    [Parameter] public string CancelText { get; set; } = "Cancelar";
    /// <summary>Pinta la confirmación como acción de daño.</summary>
    [Parameter] public bool Destructive { get; set; }
    /// <summary>Se invoca al confirmar.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }
    /// <summary>Se invoca al cancelar o pulsar Esc.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }
}
