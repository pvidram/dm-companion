<div class="ds-stat" title="@(IsManual ? "Valor manual" : null)">
    <span class="ds-stat__label">
        @Label
        @if (IsManual)
        {
            <Icon Name="IconName.Pencil" Class="ds-stat__manual" />
            <span class="ds-visually-hidden">(valor manual)</span>
        }
    </span>
    <span class="ds-stat__value ds-numeric">@Value</span>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    /// <summary>El valor lo fijó el DM a mano (no derivado): lápiz + texto para lectores, no solo color.</summary>
    [Parameter] public bool IsManual { get; set; }
}
