<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Debe ser Exe, no WinExe: Microsoft.AspNetCore.App.Internal.Assets solo añade _framework/blazor.web.js con OutputType == 'Exe'.
         La ventana sin consola en Windows se pide aparte, en el bloque de más abajo. -->
    <OutputType>Exe</OutputType>
    <ApplicationIcon>Assets\dm-companion.ico</ApplicationIcon>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <AssemblyName>DMCompanion</AssemblyName>
    <Version>0.1.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPublishable>true</IsPublishable>
    <DebugType>none</DebugType>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <!-- Con Exe el apphost de Windows saldría como aplicación de consola; esta propiedad del SDK lo marca como gráfico (subsistema GUI). -->
  <Target Name="WindowedAppHost" BeforeTargets="_GetAppHostCreationConfiguration">
    <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win')) or $(DefaultAppHostRuntimeIdentifier.StartsWith('win'))">
      <_UseWindowsGraphicalUserInterface>true</_UseWindowsGraphicalUserInterface>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\dm-companion.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\dm-companion.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmCompanion.Core\DmCompanion.Core.csproj" />
    <ProjectReference Include="..\DmCompanion.Infrastructure\DmCompanion.Infrastructure.csproj" />
    <ProjectReference Include="..\DmCompanion.Screens\DmCompanion.Screens.csproj" />
    <ProjectReference Include="..\DmCompanion.UI\DmCompanion.UI.csproj" />
  </ItemGroup>

  <!-- Se enlazan, no se copian: el comportamiento es el mismo que en el DevHost y sus tests siguen en DevHost.Tests. -->
  <ItemGroup>
    <Compile Include="..\DmCompanion.DevHost\Platform\JsonFileAppPreferences.cs" Link="Shared\JsonFileAppPreferences.cs" />
    <Compile Include="..\DmCompanion.DevHost\KestrelDetection.cs" Link="Shared\KestrelDetection.cs" />
    <Compile Include="..\DmCompanion.DevHost\VaultFileEndpoint.cs" Link="Shared\VaultFileEndpoint.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DmCompanion.Desktop.Tests" />
  </ItemGroup>
</Project>
